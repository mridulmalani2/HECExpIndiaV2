# Google Sheets Configuration
# ============================
# 
# To use Google Sheets as a data source:
# 1. Create a Google Sheet with your data
# 2. Make the sheet publicly viewable (File > Share > Anyone with link can view)
# 3. Copy the share URL and paste it below for each section
#
# URL Format Examples:
# - Full URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit#gid=GID
# - Public CSV: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/export?format=csv&gid=GID
#
# The app will automatically convert share URLs to CSV export URLs
# Leave blank to use local CSV files from /public/data/

VITE_SHEET_NEWS=
VITE_SHEET_BOLLYWOOD=
VITE_SHEET_RESTAURANTS=
VITE_SHEET_RECIPES=
VITE_SHEET_EVENTS=
VITE_SHEET_RESOURCES=

# Site Configuration
# ==================
VITE_SITE_TITLE=Experience India
VITE_SITE_DESCRIPTION=Discover Indian culture, cuisine, and cinema with HEC Paris
VITE_LOGO_URL=https://via.placeholder.com/150x50/f97316/ffffff?text=Experience+India

# Google Authentication
# =====================
# Get your Google OAuth Client ID from: https://console.cloud.google.com/
# 1. Create a new project or select existing
# 2. Go to APIs & Services > Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add authorized JavaScript origins (e.g., https://your-domain.com)
# 5. Copy the Client ID below
# Note: Client ID is safe to expose in frontend (it's not a secret)
VITE_GOOGLE_CLIENT_ID=
